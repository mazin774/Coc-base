<!DOCTYPE html>
<html lang="ckb" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Coc Base Crafter</title>
    <style>
        body {
            background-color: #0d0f12;
            color: #ffffff;
            font-family: system-ui, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 15px;
        }
        .card {
            background: #15181e;
            border: 1px solid #2a2e39;
            border-radius: 12px;
            width: 100%;
            max-width: 380px;
            padding: 20px;
            text-align: center;
        }
        .title {
            font-size: 20px;
            font-weight: bold;
            color: #50fa7b;
            margin-bottom: 15px;
        }
        input {
            width: 90%;
            padding: 10px;
            border-radius: 6px;
            border: 1px solid #3b4252;
            background: #0d0f12;
            color: #fff;
            text-align: center;
            font-size: 16px;
            margin-bottom: 10px;
        }
        button {
            background: #128c7e;
            color: white;
            border: none;
            width: 95%;
            padding: 12px;
            border-radius: 6px;
            font-weight: bold;
            cursor: pointer;
            margin-bottom: 10px;
        }
        canvas {
            background: #1b3320;
            border: 1px solid #25452c;
            border-radius: 6px;
            margin: 10px 0;
        }
        .fiverr-btn {
            background: #1a3832;
            border: 1px solid #235e52;
            color: #50fa7b;
            display: block;
            padding: 12px;
            border-radius: 6px;
            text-decoration: none;
            font-size: 14px;
            margin-top: 10px;
            font-weight: bold;
        }
    </style>
</head>
<body>

    <div class="card">
        <div class="title">⚡ AI WALL CRAFTER</div>

        <input type="text" id="userText" value="COC" placeholder="ناوێک بنووسە">
        <button onclick="drawWalls()">دروستکردنی بەیس</button>

        <br>
        <canvas id="myCanvas" width="260" height="260"></canvas>

        <a href="https://www.fiverr.com/" target="_blank" class="fiverr-btn">
            MAKE MY BASE ON FIVERR
        </a>
    </div>

    <script>
        function drawWalls() {
            var canvas = document.getElementById('myCanvas');
            var ctx = canvas.getContext('2d');
            var text = document.getElementById('userText').value || "COC";

            ctx.fillStyle = "#1b3320";
            ctx.fillRect(0, 0, 260, 260);

            ctx.fillStyle = "#ffd700";
            ctx.font = "bold 50px Arial";
            ctx.textAlign = "center";
            ctx.textBaseline = "middle";
            ctx.fillText(text, 130, 130);
        }

        window.onload = drawWalls;
    </script>

</body>
</html>
