<!DOCTYPE html>
<html lang="ckb" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>COC Wall Crafter</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #0d0f12;
            color: #ffffff;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .card-container {
            background: #15181e;
            border: 1px solid #2a2e39;
            border-radius: 16px;
            width: 100%;
            max-width: 420px;
            padding: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            text-align: center;
        }

        /* بەشی وێنەی سەرەوە */
        .banner-box {
            position: relative;
            background: linear-gradient(135deg, #1e3c72, #2a5298);
            border-radius: 12px;
            padding: 30px 15px;
            margin-bottom: 20px;
            border: 1px solid #3b4252;
            overflow: hidden;
        }

        .banner-title {
            font-size: 22px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #fff;
            text-shadow: 0 2px 4px rgba(0,0,0,0.6);
        }

        .fiverr-badge {
            background-color: #1dbf73;
            color: white;
            font-weight: bold;
            padding: 4px 12px;
            border-radius: 20px;
            display: inline-block;
            margin-top: 10px;
            font-size: 14px;
        }

        /* دوگمەی داونلۆد */
        .download-btn {
            background-color: #1f242d;
            color: #e5c07b;
            border: 1px solid #3e4451;
            width: 100%;
            padding: 14px;
            border-radius: 10px;
            font-weight: bold;
            font-size: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            cursor: pointer;
            transition: 0.3s;
            margin-bottom: 25px;
        }

        .download-btn:hover {
            background-color: #282c34;
        }

        .section-label {
            font-size: 12px;
            color: #8b92a1;
            letter-spacing: 1px;
            margin-bottom: 12px;
            text-transform: uppercase;
        }

        /* دوگمەی Make My Base */
        .action-box {
            display: flex;
            gap: 10px;
        }

        .make-base-btn {
            flex: 1;
            background-color: #1a3832;
            border: 1px solid #235e52;
            color: #50fa7b;
            padding: 14px;
            border-radius: 10px;
            text-decoration: none;
            text-align: right;
            transition: 0.3s;
        }

        .make-base-btn:hover {
            background-color: #21473f;
        }

        .btn-title {
            font-size: 16px;
            font-weight: bold;
            display: block;
        }

        .btn-sub {
            font-size: 11px;
            color: #a0aec0;
            display: block;
            margin-top: 2px;
        }

        .icon-btn {
            background-color: #1f242d;
            border: 1px solid #3e4451;
            color: #61afef;
            width: 50px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 18px;
            text-decoration: none;
        }

        .icon-btn:hover {
            background-color: #282c34;
        }
    </style>
</head>
<body>

    <div class="card-container">
        
        <!-- بەنەری سەرەوە -->
        <div class="banner-box">
            <div class="banner-title">CUSTOM COC BASE /W LINK</div>
            <div class="fiverr-badge">fiverr</div>
        </div>

        <!-- دوگمەی داونلۆد -->
        <button class="download-btn" onclick="startDownload()">
            <span>⬇️</span> DOWNLOAD STARTED
        </button>

        <div class="section-label">ENJOYING THE APP?</div>

        <!-- بەشی لینک بۆ Fiverr و پشتیوانی -->
        <div class="action-box">
            <!-- لێنکی Fiverr خۆت لە جیاتی # دابنێ -->
            <a href="https://www.fiverr.com/" target="_blank" class="make-base-btn">
                <span class="btn-title">MAKE MY BASE</span>
                <span class="btn-sub">Get your design built by me on Fiverr</span>
            </a>

            <!-- لێنکی کەناڵ یان گرووپەکەت -->
            <a href="#" class="icon-btn" title="Support/Coffee">
                ☕
            </a>
        </div>

    </div>

    <script>
        function startDownload() {
            alert('داونلۆدەکە دەستی پێکرد یاخود لێنکەکە دەکرێتەوە!');
            // لێرە دەتوانیت لێنکی ڕاستەوخۆی فایلەکە یان شتێک بنووسیت
            // window.location.href = 'لێنکی_فایلەکەت';
        }
    </script>
</body>
</html>
